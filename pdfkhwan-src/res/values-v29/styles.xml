<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10+: system dark mode must have ZERO effect on this app.
     The app owns its own dark-navy look; Force Dark is rejected so the
     system can never auto-invert / tint any view or dialog. -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
